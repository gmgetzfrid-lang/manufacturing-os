# ─── Supabase (REQUIRED) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Cloudflare R2 file storage (REQUIRED) ────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name

# ─── Cron / scheduled routes (REQUIRED in production) ─────────
# Shared secret the cron + internal drain routes require as a
# `Authorization: Bearer <value>` token (maintenance, run-scheduled,
# reminders/run, send-queued). MUST be set in production — when it is,
# those routes reject unauthenticated callers; leaving it unset makes them
# world-callable. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ─── Email delivery via Resend (required for ANY outbound email) ──
# Without RESEND_API_KEY, notification + transmittal emails stay queued
# (nothing is lost) and send as soon as the key appears. RESEND_FROM_EMAIL
# must be a sender your Resend account has verified.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@your-domain.com

# ─── Secrets-at-rest encryption (required for data-export destinations
#     and stored AI provider keys) ─────────────────────────────
# 64-char hex (32 bytes). Encrypts stored S3 credentials and AI API keys
# with AES-256-GCM. Losing/rotating it invalidates stored secrets (users
# re-enter them). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXPORT_ENCRYPTION_KEY=

# ─── Stripe billing (optional — /admin/billing) ───────────────
# Leave unset to run without billing. Price IDs are the Stripe Price objects
# for each paid tier; the webhook secret comes from the Stripe dashboard's
# webhook endpoint for /api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_WEBHOOK_SECRET=

# ─── Public origin (REQUIRED for the physical bridge) ─────────
# The canonical production URL (e.g. https://app.yourrefinery.com). Every
# QR printed on a stamped copy, label, hold card, traveler or pack cover,
# and every share / transmittal / emailed link, is built on it
# (lib/publicOrigin.ts). Set it in EVERY environment, previews included, so
# a print made on a preview deploy still verifies against production.
# Unset, the app falls back to Vercel's production domain
# (VERCEL_PROJECT_PRODUCTION_URL) — never VERCEL_URL, which on a preview is
# the preview's own login-gated host. A browser reads that domain only when
# Vercel exposes its system environment variables; otherwise it falls back
# to the page's own address, which on a preview is that gated host. With
# neither, server-stamped copies carry no verify QR (and no instruction to
# scan one; the stamp logs a warning) and no transmittal portal link is
# emailed; the copied portal link and the cover-sheet QR use the browser's
# own address, except on a *.vercel.app host or localhost, where none is
# built. Self-hosting with Docker: NEXT_PUBLIC_* values are baked in at build
# time — docker compose passes this one from .env as a build arg
# (docs/SELF_HOST_DOCKER.md); rebuild the image after changing it.
NEXT_PUBLIC_SITE_URL=

# The facility's IANA time zone (e.g. America/Chicago). Decides the calendar
# day a controlled revision's effective date comes into force — the badge,
# the "now in effect" scan and the announcement watermark all ask it. Unset,
# effective dates are decided in UTC-12 (the latest calendar): never early,
# but late by the facility's UTC offset plus 12 hours — about a day, up to
# 26 hours for a UTC+14 site — for the badge and the announcement (east of
# UTC, a revision made effective "today" at publish reads pending and is
# then announced as newly in force). The app logs an error once per runtime
# while it is unset. Set it before deploying (document-control REV-9).
NEXT_PUBLIC_FACILITY_TIME_ZONE=

# ─── Misc (optional) ──────────────────────────────────────────
# Cap for embedding files inline in data exports, in bytes (default in code).
# EXPORT_MAX_EMBED_BYTES=
