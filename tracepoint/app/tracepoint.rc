      VALUE "OriginalFilename", "TracePoint.exe"
      VALUE "ProductName", "TracePoint"
      VALUE "ProductVersion", "2.0.0"
      VALUE "LegalCopyright", "Internal tool"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
