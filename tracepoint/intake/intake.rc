    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Kern Energy"
      VALUE "FileDescription", "Scan Intake - scanned records filing"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "Scan Intake"
      VALUE "OriginalFilename", "ScanIntake.exe"
      VALUE "ProductName", "Scan Intake"
      VALUE "ProductVersion", "1.0.0"
      VALUE "LegalCopyright", "Internal tool"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
