{
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" = \"master\" ] || [ -n \"$VERCEL_GIT_PULL_REQUEST_ID\" ] || [ \"${VERCEL_GIT_COMMIT_REF#claude/}\" != \"$VERCEL_GIT_COMMIT_REF\" ] && exit 1 || exit 0",
  "crons": [
    {
      "path": "/api/data-export/run-scheduled",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 3 * * *"
    }
  ]
}
